# secrets — never committed, see .env.example
# *.local.md is the key-handoff scratch pad. Listed FIRST and before the file
# is ever created, so there is no window in which a paste could be committed.
*.local.md
.env
.env.local
.env*.local
*.pem
*.key

# deps / build
node_modules/
.next/
out/
dist/
build/
.vercel/
.turbo/

# misc
.DS_Store
*.log
npm-debug.log*
coverage/
.idea/
.vscode/

# typescript incremental build cache
# (next-env.d.ts is intentionally committed: CI typechecks without running
#  next build, so the file must already be on disk)
*.tsbuildinfo
