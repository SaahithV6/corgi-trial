# ---------------------------------------------------------------------------
# Corgi work trial — Track 3, Neobank
#
# Copy to .env and fill in. .env is gitignored and must stay that way.
# THIS FILE HOLDS NO REAL VALUES. Placeholders only, forever.
#
# Every key below is required; src/lib/env.ts validates them with zod at
# startup and refuses to boot with a message naming each missing key.
# All of these are server-only secrets. None may ever be renamed to
# NEXT_PUBLIC_*, and none may be imported from a client component.
#
# Sandbox / testnet credentials only. No production keys, no mainnet keys,
# no real cardholder data.
# ---------------------------------------------------------------------------

# --- Storage ---------------------------------------------------------------

# Postgres connection string. Neon dashboard -> your project -> Connection
# Details -> pooled connection string. Include ?sslmode=require.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# --- Card issuing: Lithic (sandbox) ----------------------------------------

# Lithic sandbox API key. https://sandbox.lithic.com -> Developers -> API Keys.
LITHIC_API_KEY=""

# Shared secret Lithic signs webhooks with, used to verify inbound
# authorisation and clearing events. Developers -> Webhooks -> the endpoint's
# secret. Rotating this in the dashboard requires redeploying.
LITHIC_WEBHOOK_SECRET=""

# --- KYB / KYC: Persona (sandbox) ------------------------------------------

# Persona sandbox API key. https://app.withpersona.com -> API Keys.
# Sandbox keys are prefixed persona_sandbox_.
PERSONA_API_KEY=""

# Persona webhook shared secret, used to verify inquiry status callbacks.
# Persona dashboard -> Webhooks -> select the webhook -> Secret.
PERSONA_WEBHOOK_SECRET=""

# --- Open banking funding: Plaid (sandbox) ---------------------------------

# Plaid client id, shared across environments.
# https://dashboard.plaid.com -> Developers -> Keys -> client_id.
PLAID_CLIENT_ID=""

# Plaid Sandbox secret (NOT the development or production secret).
# https://dashboard.plaid.com -> Developers -> Keys -> Sandbox secret.
PLAID_SECRET=""

# --- ACH rail: Increase (sandbox) ------------------------------------------

# Increase sandbox API key. https://dashboard.increase.com -> Developers ->
# API Keys, with the environment switcher set to Sandbox.
INCREASE_API_KEY=""

# Increase webhook secret for verifying transfer lifecycle and return events.
# Developers -> Event Subscriptions -> the subscription's shared secret.
INCREASE_WEBHOOK_SECRET=""

# --- Collections: Stripe (test mode) ---------------------------------------

# Stripe test-mode secret key, sk_test_...
# https://dashboard.stripe.com/test/apikeys. Never a live key here.
STRIPE_SECRET_KEY=""

# Stripe webhook signing secret, whsec_... From the dashboard's Webhooks page
# for a hosted endpoint, or printed by `stripe listen --forward-to ...` when
# testing locally. The two differ; use the one matching how you receive events.
STRIPE_WEBHOOK_SECRET=""

# --- Stablecoin payout: USDC on Base Sepolia -------------------------------

# 0x-prefixed 32-byte private key of the payout wallet, used to sign USDC
# transfers with viem. TESTNET ONLY — generate a throwaway key (e.g.
# `cast wallet new`) and fund it from a Base Sepolia faucet. Never a key that
# has ever held mainnet value.
USDC_SENDER_PRIVATE_KEY=""

# The 0x-prefixed address derived from USDC_SENDER_PRIVATE_KEY. Kept explicit
# so a key/address mismatch fails at boot rather than at the first payout.
USDC_SENDER_ADDRESS=""

# Base Sepolia JSON-RPC endpoint. The public https://sepolia.base.org works
# but is rate limited; an Alchemy or Infura Base Sepolia URL is steadier.
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"

# USDC token contract on Base Sepolia. This is a public, well-known address
# and is the only value in this file that is real:
USDC_CONTRACT_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"
