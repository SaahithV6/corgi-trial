# =============================================================================
# Corgi work trial — Track 3, neobank
#
# Copy to `.env` and fill in. `.env` is gitignored; this file must never hold a
# real value. Every key below is one the code actually reads — the list was
# generated by grepping `src/lib/env.schema.ts` and every `process.env.` in the
# tree, not written from memory, because an .env.example that has drifted from
# the code is worse than none: it teaches a fresh clone the wrong shape.
#
# ONE key is required to boot. Everything else degrades to a simulator and says
# so on /api/health. That is deliberate: a slot can only be labelled
# `simulated` honestly if the system is allowed to run without its credential.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — nothing starts without this
# -----------------------------------------------------------------------------

# Neon POOLED connection string, as the `corgi_app` role.
#
# NOT the owner. corgi_app holds SELECT and INSERT on the money tables and
# nothing else — it physically cannot express `UPDATE journal_entry`, and
# `pnpm db:check` proves it by attempting one. Earlier in this build the app
# was pointed at the Neon owner and every forbidden operation SUCCEEDED,
# because privileges never bind a table's owner. db:check went from 5/14 to
# 14/14 the moment the role changed, with no code change at all.
#
# Neon console -> project -> Connect -> Connection string (pooling ON).
APP_DATABASE_URL="postgresql://corgi_app:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"


# -----------------------------------------------------------------------------
# SCRIPTS ONLY — never give this to the running application
# -----------------------------------------------------------------------------

# Neon UNPOOLED connection as the OWNER. Used by scripts/migrate.mjs,
# scripts/seed.mjs and scripts/dbreset.mjs, run from a terminal.
#
# Unpooled because Neon's pooler is PgBouncer in transaction mode, where a
# session-level advisory lock does not survive between statements. The migration
# runner takes one.
#
# Do NOT set this in the deployed environment. Putting it there hands the
# running system the one capability the whole privilege model exists to
# withhold.
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"


# -----------------------------------------------------------------------------
# CARD ISSUING — Lithic sandbox.  Absent => simulated.
# -----------------------------------------------------------------------------

# Raw UUID. The header is `Authorization: <key>` — no Bearer, no base64.
# app.lithic.com -> Settings.
LITHIC_API_KEY=

# Standard Webhooks signing secret, base64 after the `whsec_` prefix.
# Created with the subscription; fetch via
#   GET /v1/event_subscriptions/{token}/secret
LITHIC_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# IDENTITY — Persona preferred, Stripe Identity is the live fallback
# -----------------------------------------------------------------------------

# Persona sandbox key. Preferred because perform-simulate-actions drives an
# inquiry to pending / declined / needs_review AND fires the real webhooks for
# each, so the non-happy-path states are genuinely third-party.
# Persona's BUSINESS verification is gated behind a sales conversation; this
# key covers director KYC only.
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# OPEN BANKING — Plaid sandbox.  Absent => simulated.
# -----------------------------------------------------------------------------

# dashboard.plaid.com -> Developers -> Keys. Use the SANDBOX secret.
PLAID_CLIENT_ID=
PLAID_SECRET=


# -----------------------------------------------------------------------------
# ACH RAIL — Increase sandbox.  Absent => the labelled simulator runs instead.
# -----------------------------------------------------------------------------

INCREASE_API_KEY=

# Increase does NOT generate this — you choose it when creating the event
# subscription, and it is used as raw UTF-8 bytes for the HMAC (unlike Lithic
# and Stripe, whose whsec_ secrets are base64-decoded first).
INCREASE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# STRIPE — Identity is live; Connect (the KYB registry leg) is gated.
# -----------------------------------------------------------------------------

# MUST begin `sk_test_`. The environment schema REFUSES an `sk_live_` key at
# boot: holding one is an automatic fail for this trial, so it is a control
# rather than a rule to remember.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# STABLECOIN — USDC on Base Sepolia.  TESTNET ONLY.
# -----------------------------------------------------------------------------

# A throwaway key that has never touched real funds. Never a mainnet key.
USDC_SENDER_PRIVATE_KEY=
USDC_SENDER_ADDRESS=

# Public RPC, no API key needed.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Circle's official USDC on Base Sepolia, 6 decimals. Public, not a secret.
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e


# -----------------------------------------------------------------------------
# OPERATIONS
# -----------------------------------------------------------------------------

# Bearer token for POST /api/drain. The drain is idempotent by construction, so
# an unauthenticated caller could not corrupt anything — it is authenticated
# because an open endpoint that does real work is free load for anyone who
# finds it. Vercel Cron is authorised separately by its `x-vercel-cron` header.
DRAIN_TOKEN=

# MCP agent grants, a JSON array. Prefer `tokenSha256` over `token` so the
# environment holds a digest and an env dump is not a credential.
# Each grant is scoped to exactly one business and one agent actor; the actor
# row must be kind='agent' with can_approve=false or the grant is refused.
# See docs/MCP.md.
MCP_AGENT_TOKENS='[{"label":"demo","tokenSha256":"<sha256 hex of the token>","actorId":"<uuid>","businessId":"<uuid>","rateLimitPerMinute":60,"maxInstructionCents":"500000"}]'

# `true` exposes the /api/sim control routes for the ACH simulator.
# Must be absent or false in any shared environment.
SIM_CONTROL_ENABLED=false


# -----------------------------------------------------------------------------
# OPTIONAL OVERRIDES — sensible defaults, set only to point elsewhere
# -----------------------------------------------------------------------------

# LITHIC_BASE_URL=https://sandbox.lithic.com/v1
# INCREASE_BASE_URL=https://sandbox.increase.com
# ACH_SIM_WEBHOOK_SECRET=            # simulator signing key; must NOT equal INCREASE_WEBHOOK_SECRET
# APP_BASE_URL=http://localhost:3000 # used by server-side self-fetches when not on Vercel


# -----------------------------------------------------------------------------
# TESTS AND SCRIPTS — not read by the application
# -----------------------------------------------------------------------------

# RUN_DB_TESTS=1                     # enable the live-database integration tests
# WEBHOOK_INBOX_TEST_DATABASE_URL=   # a separate Neon branch for inbox tests
# LIVEFIRE_BASE_URL=                 # target for scripts/livefire.mjs (defaults to production)
# FORCE_RESET=yes                    # DESTRUCTIVE. Lets scripts/dbreset.mjs drop a schema
                                     # that already holds posted money. Never set casually.

# Comma-separated KYB legs to force to the simulator regardless of credentials.
# Set to business_registry: Stripe Connect is gated, so a present STRIPE_SECRET_KEY
# must not be read as a live business-registry capability.
KYB_FORCE_SIMULATED=business_registry
