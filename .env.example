# =============================================================================
# Corgi work trial — Track 3, neobank
#
# Copy to `.env` and fill in. `.env` is gitignored; THIS FILE MUST NEVER HOLD A
# REAL VALUE. The two values that are filled in below are public constants —
# a public RPC endpoint and Circle's published testnet USDC contract address —
# not credentials.
#
# The key list is generated, not remembered: `src/lib/env.schema.ts` plus every
# `process.env.` and `readEnv(...)` in `src/` and `scripts/`. An .env.example
# that has drifted from the code is worse than none, because it teaches a fresh
# clone the wrong shape.
#
# ONE key is required to boot. Every other credential is optional, and its
# absence selects that slot's labelled simulator rather than raising an error.
# That is deliberate: a slot can only be labelled `simulated` honestly if the
# system is allowed to run without its credential. `/api/health` reports which
# way every slot actually resolved, by making a real call.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — nothing starts without this
# -----------------------------------------------------------------------------

# Neon POOLED connection string, as the `corgi_app` role.
#
# NOT the owner. corgi_app holds SELECT and INSERT on the money tables and
# nothing else — it physically cannot express `UPDATE journal_entry`, and
# `pnpm db:check` proves it by attempting one. Earlier in this build the app
# was pointed at the Neon owner and every forbidden operation SUCCEEDED,
# because privileges never bind a table's owner. db:check went from 5 passes of
# 14 to 14 of 14 the moment the role changed, with no code change at all.
# (That run was 14 checks. It is 25 today: the same fourteen, plus eleven
# invariant views that must each return zero rows and that nothing ran on the
# way to a commit until they were added to this script.)
#
# Neon console -> project -> Connect -> Connection string (pooling ON).
APP_DATABASE_URL="postgresql://corgi_app:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"


# -----------------------------------------------------------------------------
# SCRIPTS ONLY — never give this to the running application
# -----------------------------------------------------------------------------

# Neon UNPOOLED connection as the OWNER. Used by scripts/migrate.mjs,
# scripts/seed.mjs and scripts/dbreset.mjs, run from a terminal.
#
# Unpooled because Neon's pooler is PgBouncer in transaction mode, where a
# session-level advisory lock does not survive between statements. The migration
# runner takes one.
#
# Do NOT set this in the deployed environment. Putting it there hands the
# running system the one capability the whole privilege model exists to
# withhold.
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Legacy fallback name. `scripts/migrate.mjs` and the one-off repair script read
# `DIRECT_URL` first and fall back to this. Prefer DIRECT_URL; this exists so an
# older shell profile keeps working rather than failing obscurely.
# DATABASE_URL=


# -----------------------------------------------------------------------------
# CARD ISSUING — Lithic sandbox.  Absent => simulated.
#
# This is the slot the brief marks "must be live", and it is the one the card
# authorisation lifecycle, the hold model and the ASA decision webhook all hang
# off. Two keys: the API key issues cards and simulates authorisations, the
# webhook secret verifies what comes back.
# -----------------------------------------------------------------------------

# Raw UUID. The header is `Authorization: <key>` — no Bearer, no base64.
# app.lithic.com -> Settings.
LITHIC_API_KEY=

# Standard Webhooks signing secret, base64 after the `whsec_` prefix.
# Created with the subscription; fetch via
#   GET /v1/event_subscriptions/{token}/secret
# The same secret verifies BOTH Lithic endpoints: the asynchronous event feed at
# /api/webhooks/lithic and the synchronous ASA decision endpoint at
# /api/webhooks/lithic-auth.
LITHIC_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# DIRECTOR KYC — Persona sandbox.  Absent => Stripe Identity is used instead.
#
# Not configured in the deployed environment. `STRIPE_SECRET_KEY` below carries
# this slot. Persona is wired and would take over if these were set; it is the
# week-two swap, because Persona can be DRIVEN to declined and needs_review
# while Stripe Identity cannot.
# -----------------------------------------------------------------------------
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# OPEN BANKING — Plaid sandbox.  Absent => the funding screen has no linked
# account to draw from.
#
# Also carries the payee-identity leg: when Plaid holds an Item for the
# destination account, `/identity/get` returns the institution's own record of
# the account-holder name, which is the only real name verification available
# on US ACH.
# -----------------------------------------------------------------------------

# dashboard.plaid.com -> Developers -> Keys.
PLAID_CLIENT_ID=

# The SANDBOX secret. Never the production one.
PLAID_SECRET=


# -----------------------------------------------------------------------------
# ACH RAIL — Increase sandbox.  Absent => the labelled ACH simulator is
# selected, and says so in a warn log line and on /api/health.
# -----------------------------------------------------------------------------

# dashboard.increase.com. A sandbox key; the base URL below pins the sandbox.
INCREASE_API_KEY=

# Standard Webhooks secret for the transfer lifecycle and returns.
INCREASE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# STRIPE — director KYC via Stripe Identity.
#
# A key beginning `sk_live` is REFUSED at boot by src/lib/env.schema.ts. Live
# keys are an automatic fail for the whole trial, so the refusal is at the
# boundary rather than in a code review.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# STABLECOIN, PROVIDER ONE — direct signing against Base Sepolia.
#
# This path builds, signs and broadcasts the ERC-20 transfer itself, so it knows
# the transaction hash before the money can move. TESTNET ONLY.
# -----------------------------------------------------------------------------

# A THROWAWAY Base Sepolia key that has never touched real funds. 0x + 64 hex.
USDC_SENDER_PRIVATE_KEY=

# The address derived from the key above. 0x + 40 hex. Checked against the key.
USDC_SENDER_ADDRESS=

# Public endpoint, no API key. Not a secret.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Circle's USDC on Base Sepolia, 6 decimals. A published constant, not a secret.
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Default destination for scripts/payout-usdc.mjs when --to is not passed.
# USDC_PAYOUT_RECIPIENT=

# EIP-155 chain id, asserted by scripts/payout-usdc.mjs against what the node
# reports. Base Sepolia is 84532.
# BASE_SEPOLIA_CHAIN_ID=84532


# -----------------------------------------------------------------------------
# STABLECOIN, PROVIDER TWO — Circle Web3 Services developer-controlled wallet.
#
# The second provider behind the same rail interface. A missing key here is
# `not_configured` and NEVER a silent fallback to the direct path above: the
# caller asked for Circle, and money leaving over a rail they did not choose is
# the failure this refuses to have.
#
# Web3 Services has exactly ONE host, https://api.circle.com — the KEY PREFIX
# selects the environment, not the hostname. So a key that does not begin
# `TEST_API_KEY` is refused as unusable rather than used.
# -----------------------------------------------------------------------------

# Sandbox key. MUST begin `TEST_API_KEY`.
CIRCLE_API_KEY=

# 32 bytes as 64 hex characters. Circle generates it; the console registers its
# ciphertext. It is encrypted fresh for every mutating request and never logged.
# Circle's own console warns never to put this in source control or a config
# file — it lives in .env here, which is a gitignored local dotfile holding a
# testnet credential, and saying that plainly is better than implying a secrets
# manager that does not exist.
CIRCLE_ENTITY_SECRET=

# Optional pins. Absent means "discover the only one, or create it".
# CIRCLE_WALLET_SET_ID=
# CIRCLE_WALLET_ID=
# CIRCLE_TOKEN_ID=                   # Circle's own uuid for USDC on this chain

# Override the single Web3 Services host. Only for a test double.
# CIRCLE_BASE_URL=https://api.circle.com


# -----------------------------------------------------------------------------
# OPERATIONAL
# -----------------------------------------------------------------------------

# Bearer token for POST /api/drain and POST /api/cron/standing.
#
# Both routes also accept Vercel's `x-vercel-cron` header. With neither the
# header nor this token, both answer 401 — there is no unauthenticated path and
# no development bypass.
DRAIN_TOKEN=

# Agent grants for POST /api/mcp. A JSON array. The token itself is NEVER
# stored — only its sha256 — so this file cannot leak one even if it were
# committed. Each grant is scoped to one actor, one business, a per-minute rate
# and a maximum instruction size. See docs/MCP.md.
MCP_AGENT_TOKENS='[{"label":"demo","tokenSha256":"<sha256 hex of the token>","actorId":"<uuid>","businessId":"<uuid>","rateLimitPerMinute":60,"maxInstructionCents":"500000"}]'

# Exposes /api/sim, the ACH simulator's control surface. Must be absent or
# false in any shared environment. It is absent in the deployment.
SIM_CONTROL_ENABLED=false

# Comma-separated KYB legs forced to the simulator regardless of credentials.
# Accepts `business_registry`, `director_kyc`, or `all`.
#
# LEAVE THIS UNSET. It shipped here set to `business_registry`, and that was a
# real defect in this file rather than a stylistic one: it dated from when the
# registry leg probed Stripe Connect, which is gated, and a present
# STRIPE_SECRET_KEY must not read as a live registry capability. The registry
# leg is GLEIF now — a public API, no credential at all, live on every request —
# and `selectRegistryLeg()` treats this variable as the ONLY way that leg can
# become simulated. So a fresh clone that copied this file got a SIMULATED
# registry leg for a live integration that needs no key, and `/api/health` would
# have said so correctly while the operator wondered why.
#
# It is deliberately kept, commented, because it is the switch that proves the
# simulator exists and is reachable — set it and watch the onboarding screen's
# evidence label change from `live` to `simulated`.
# KYB_FORCE_SIMULATED=business_registry

# trace | debug | info | warn | error. Defaults from NODE_ENV.
# LOG_LEVEL=info


# -----------------------------------------------------------------------------
# OPTIONAL OVERRIDES — sensible defaults, set only to point elsewhere
# -----------------------------------------------------------------------------

# LITHIC_BASE_URL=https://sandbox.lithic.com/v1
# INCREASE_BASE_URL=https://sandbox.increase.com
# PLAID_BASE_URL=https://sandbox.plaid.com
# PLAID_ENV=sandbox                  # anything but `production` IS the sandbox
# APP_BASE_URL=http://localhost:3000 # server-side self-fetches when not on
#                                    # Vercel; also how the Lithic webhook probe
#                                    # works out which URL it registered
# ACH_SIM_WEBHOOK_SECRET=            # simulator signing key; must NOT equal
#                                    # INCREASE_WEBHOOK_SECRET
# ACH_SIM_CONTROL_ENABLED=true       # non-production only; gates /api/sim
# ACH_SIM_SEED=achsim                # deterministic simulator seed

# Vercel sets these; do not set them by hand. VERCEL_GIT_COMMIT_SHA is what
# /api/health reports as the running commit, and VERCEL_PROJECT_PRODUCTION_URL
# is how the webhook probe knows which URL the provider is delivering to.


# -----------------------------------------------------------------------------
# KEYS THIS SYSTEM DELIBERATELY DOES NOT NEED
#
# Listed because their absence is a design decision rather than an omission, and
# because somebody will otherwise go looking for them.
# -----------------------------------------------------------------------------

# BUSINESS REGISTRY (KYB) — none. `api.gleif.org` is the Global LEI Foundation's
#   public API: no key, no signup, no rate-limit header. Every record in it was
#   validated by an accredited Local Operating Unit against a government company
#   register, and the record names which register. It is a SUBSTITUTION for
#   Middesk / Persona KYB / Sumsub KYB, all of which were measured gated behind a
#   sales conversation. The README says so in those words.
#
# FX RATES — none. `https://api.frankfurter.dev/v1/latest?base=USD&symbols=…` is
#   the ECB's daily reference rates, republished. The mid rate is live and the
#   spread is ours, and `/payouts` prints that split on the page.
#
# AN AUTH SECRET — none. There is no authentication system; it was cut on day
#   one and stayed cut. The role switcher is a cookie, it is labelled as one in
#   two file headers, and it grants nothing: the actor is resolved by a SELECT
#   with a WHERE clause and handed to the database, which decides.


# -----------------------------------------------------------------------------
# SET BY THE PLATFORM — read, never written by you
#
# Vercel injects these. They are documented because /api/health reports two of
# them and a self-hosted deployment has to supply the equivalents.
# -----------------------------------------------------------------------------

# VERCEL_GIT_COMMIT_SHA          reported by /api/health as the running commit
# VERCEL_PROJECT_PRODUCTION_URL  how the Lithic webhook probe knows which URL the
#                                provider is delivering to; it appears verbatim
#                                in that slot's evidence string
# VERCEL_URL                     the per-deployment hostname, used for server-side
#                                self-fetches when APP_BASE_URL is unset
# NODE_ENV                       `production` on the deployment; it is what
#                                LOG_LEVEL defaults from, and what makes an
#                                `sk_live` Stripe key a boot-time refusal
# NO_COLOR                       honoured by the scripts' output, per no-color.org


# -----------------------------------------------------------------------------
# TESTS AND SCRIPTS — not read by the application
# -----------------------------------------------------------------------------

# RUN_DB_TESTS=1                     # enable the live-database integration tests
# RUN_LIVE_TESTS=1                   # enable the tests that call provider sandboxes
# RUN_POT_DEMO=1                     # enable the pots end-to-end demo test
# WEBHOOK_INBOX_TEST_DATABASE_URL=   # a separate Neon branch for inbox tests
# LIVEFIRE=1                         # set by scripts/livefire.mjs; without it every
#                                    # file in src/test/livefire skips, so `pnpm test`
#                                    # never fires a real card authorisation
# LIVEFIRE_BASE_URL=                 # target for scripts/livefire.mjs (defaults to production)
# LIVEFIRE_EVIDENCE=                 # path the runner writes its evidence JSON to
# LIVEFIRE_OUTAGE_SECONDS=           # length of the simulated provider outage in attack 7
# CORELOOP_BASE_URL=                 # target for scripts/coreloop.mjs (defaults to production)
# FORCE_RESET=yes                    # DESTRUCTIVE. Lets scripts/dbreset.mjs drop a schema
#                                    # that already holds posted money. Never set casually.

# Coinbase Developer Platform Ed25519 key, used ONLY by scripts/faucet.mjs to
# top the testnet wallet up with gas. The application never reads these.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
