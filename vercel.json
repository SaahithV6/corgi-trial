{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "iad1"
  ],
  "functions": {
    "src/app/api/webhooks/[provider]/route.ts": {
      "maxDuration": 15
    },
    "src/app/api/health/route.ts": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/drain",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/cron/standing",
      "schedule": "23 5 * * *"
    },
    {
      "path": "/api/cron/accrual",
      "schedule": "41 6 * * *"
    }
  ]
}
