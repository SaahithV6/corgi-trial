{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "vitest.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/test/**",
    "**/__tests__/**",
    "test/**"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "research",
    "plan",
    "thread"
  ]
}